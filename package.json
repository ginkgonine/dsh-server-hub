{
  "name": "dsh-server-hub",
  "version": "0.3.0-beta.1",
  "description": "A persistent multi-server switcher for DeepSeek Harness Web",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./remote": "./lib/remote/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/remote",
    "src/index.js",
    "src/client.js",
    "src/remote",
    "docs/remote-agents.md",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "test": "node --test",
    "check": "npm run build && node ./scripts/check.mjs && npm test",
    "prepack": "npm run check"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "server-hub",
    "tunnel",
    "multi-server"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ginkgonine/dsh-server-hub.git"
  },
  "homepage": "https://github.com/ginkgonine/dsh-server-hub#readme",
  "bugs": {
    "url": "https://github.com/ginkgonine/dsh-server-hub/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-connection": "^0.1.5-0 || ^0.2.0-0",
    "@deepseek-ai/dsh-host-webserver": "^0.1.5-0 || ^0.2.0-0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-client-connection": { "optional": true },
    "@deepseek-ai/dsh-host-webserver": { "optional": true },
    "react": { "optional": true }
  }
}
